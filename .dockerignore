# Dependencies — never needed in the image (npm ci runs inside the builder stage)
node_modules

# Local build output — the builder stage produces its own clean build
dist
dist-ssr

# Environment files — never bake secrets into the image
.env
.env.*
!.env.production

# Version control
.git
.gitignore

# Editor / IDE config
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# CI / coverage artefacts
coverage
.nyc_output

# Docker itself
Dockerfile
.dockerignore
